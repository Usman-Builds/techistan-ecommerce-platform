# =============================================================================
# Environment for the containerised backend.
#
#     cp backend/.env.docker.example backend/.env.docker
#
# Compose loads this file into the api, migrate and seed containers. It is NOT
# baked into the image and NOT read by "npm run start:dev" on the host -- your
# existing .env.development is untouched and stays authoritative for local runs.
#
# Generate each secret with:  openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# NODE_ENV drives two separate things, which is worth knowing before you change
# it. It selects which .env.<NODE_ENV> file the app looks for inside the
# container (none is shipped, so this file is the only source -- that is fine),
# and it decides which variables config/validation.ts treats as MANDATORY.
#
# On "production" the app refuses to boot without all of:
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET,
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, CRON_SECRET
#
# "development" leaves those optional and degrades gracefully instead: media
# uploads fail at call time, checkout errors when reached, and EmailService logs
# what it would have sent. That is the right setting for a container you are
# bringing up locally; switch to production once the keys above are filled in.
# -----------------------------------------------------------------------------
NODE_ENV=development

APP_NAME=Techistan
PORT=3000

# The two Next.js clients, still running on the host. CORS is credentialed, so
# these must match the browser's origin exactly -- scheme, host and port.
CLIENT_ORIGINS=http://localhost:3001,http://localhost:3002
USER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Database. "db" is the compose service name, resolved on the private network --
# not localhost, which inside a container means the container itself.
#
# To use a database on the host instead (your existing local Postgres, say),
# point this at host.docker.internal:5432 and stop the db service.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://techistan:techistan@db:5432/ecom?schema=public

# -----------------------------------------------------------------------------
# Auth. Required in every NODE_ENV -- the app will not start without them.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=2592000

# Signs the guest cart cookie. Falls back to JWT_SECRET when blank; give it a
# distinct value before this is exposed to anyone but you.
CART_COOKIE_SECRET=

# -----------------------------------------------------------------------------
# Preseeded SUPER_ADMIN. Required in every NODE_ENV (validation reads them at
# boot even though only the seed writes them). Password must be 8+ characters.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@techistan.dev
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Third-party services. Optional in development, mandatory in production.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
# From "stripe listen --forward-to localhost:3000/payments/webhook".
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Techistan <noreply@techistan.dev>
ADMIN_EMAIL_ALERTS=false

# Bearer secret for the POST /cron/* routes. The in-process @Cron schedule runs
# regardless; this only guards the manual triggers.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
SEARCH_DRIVER=pg
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
