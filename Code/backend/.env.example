# Techistan backend (NestJS) — copy to .env.development and fill in.
# Never commit real secrets; only this .env.example is tracked.

NODE_ENV=development
APP_NAME=Techistan
PORT=3000

# Comma-separated allowed client origins (CORS, credentials enabled)
CLIENT_ORIGINS=http://localhost:3001,http://localhost:3002

# Database (local Postgres DB name: ecom)
DATABASE_URL=postgresql://user:pass@localhost:5432/ecom?schema=public

# Auth — JWT
JWT_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=2592000

# Admin preseed (script 05)
ADMIN_EMAIL=admin@techistan.dev
ADMIN_PASSWORD=

# Cloudinary (script 06)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Search (script 08) — 'pg' = Postgres full-text search (zero-infra default)
SEARCH_DRIVER=pg

# Cart (script 09) — secret used to SIGN the guest cart cookie. Optional in dev
# (falls back to JWT_SECRET); set a distinct value in production.
CART_COOKIE_SECRET=

# Stripe (script 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (script 16) — Resend transport. Leave RESEND_API_KEY blank in dev to
# have the backend log intended sends instead of dispatching them.
RESEND_API_KEY=
EMAIL_FROM=Techistan <noreply@techistan.dev>
# Optional: also email ADMIN_EMAIL on new-order / low-stock / new-review alerts.
# The in-app admin bell fires regardless; this only toggles the email copy.
ADMIN_EMAIL_ALERTS=false

# Scheduled jobs (script 16) — bearer/x-cron-secret for POST /cron/* routes.
# Required in production; optional in dev (the @Cron schedule still runs in-process).
CRON_SECRET=

# SMS (script 16, FR-905 — optional/Could). Inert unless SMS_ENABLED=true.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Frontend base URLs (for emails/redirects)
USER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
