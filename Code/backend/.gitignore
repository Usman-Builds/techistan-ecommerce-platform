# dotenv environment variable files — ignore all except the committed templates.
# .env.* swallows .env.docker.example too, so it needs its own escape hatch;
# .env.docker itself (the filled-in copy Compose reads) stays ignored.
.env
.env.*
!.env.example
!.env.docker.example

