# NestJS backend. The browser reaches it through this app's /api/* rewrite
# (next.config.ts), so auth cookies stay first-party. Baked in at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The storefront's public origin, for the "view on storefront" links in the
# homepage builder, navigation and category pages. Baked in at BUILD time.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# Server-only (never NEXT_PUBLIC_). Must equal the backend's PROXY_SECRET. The
# server forwards each visitor's IP to the API with it, so the API rate-limits
# per visitor instead of per this server (see src/lib/server/backend-headers.ts).
# Optional locally; required in production or visitors share one 429 bucket.
PROXY_SECRET=
