# NestJS backend. The browser reaches it through this app's /api/* rewrite
# (next.config.ts), so auth cookies stay first-party. Baked in at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The storefront's own public origin — used for metadataBase, canonical URLs,
# sitemap.xml, robots.txt, and JSON-LD absolute URLs (script 17).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Privacy-friendly analytics (script 17, NFR-705). Plausible is cookieless and
# loads without consent; set it to your verified domain to enable. GA4 is
# optional and only initializes AFTER the visitor accepts cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
